                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"test\",\n  \"filters\": {\n    \"type\": \"tasks\",\n    \"status\": \"active\",\n    \"priority\": \"high\"\n  }\n}"
            }
          }
        }
      ]
    },
